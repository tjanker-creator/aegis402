#pragma version 10
// ============================================================================
// AEGIS402 — guard v2 (IMMUTABLE)
//
// Same enforcement as v1, plus the guard's own fee — and the fee is not
// optional. The guard approves a payment only when the group ALSO contains a
// transfer paying the guard's treasury. So the answer to "who pays for the
// security?" is enforced by the security itself: no fee, no approval, no
// payment.
//
// app args: [0] index of the payment txn, [1] index of the guard-fee txn
//
// Enforces on the payment : is an ASA transfer
//                           amount <= CAP_MICRO
//                           receiver == ALLOWED_RECEIVER
// Enforces on the fee     : is an ASA transfer of the same asset
//                           receiver == GUARD_TREASURY
//                           amount >= 1% of the payment
//                           amount >= FEE_MIN
// ============================================================================

txn ApplicationID
int 0
==
bnz allow

// immutable: only plain calls, never update or delete
txn OnCompletion
int NoOp
==
bz reject

txn NumAppArgs
int 2
==
bz reject

txna ApplicationArgs 0
btoi
store 0          // payment index

txna ApplicationArgs 1
btoi
store 1          // fee index

// --- a per-transaction cap is no cap unless the group is bounded ----------
// Otherwise the holder of the operational key puts several transfers in one
// group, each individually within the cap, and spends a multiple of it.
// Count every asset transfer in the group: only the two we account for may
// exist, and they must be distinct.
int 0
store 6
int 0
store 7

count_loop:
  load 6
  global GroupSize
  <
  bz count_done
  load 6
  gtxns TypeEnum
  int axfer
  ==
  bz count_next
  load 7
  int 1
  +
  store 7
count_next:
  load 6
  int 1
  +
  store 6
  b count_loop
count_done:

load 7
int 2
==
bz reject

load 0
load 1
==
bnz reject

// --- the payment ---------------------------------------------------------
load 0
gtxns TypeEnum
int axfer
==
bz reject

// a cap means nothing unless it is denominated in a known asset
load 0
gtxns XferAsset
int GUARDED_ASSET
==
bz reject

load 0
gtxns AssetAmount
int CAP_MICRO
<=
bz reject

load 0
gtxns AssetReceiver
addr ALLOWED_RECEIVER
==
bz reject

// --- the guard's fee -----------------------------------------------------
load 1
gtxns TypeEnum
int axfer
==
bz reject

load 1
gtxns AssetReceiver
addr GUARD_TREASURY
==
bz reject

// paid in the same asset as the payment
load 0
gtxns XferAsset
load 1
gtxns XferAsset
==
bz reject

// at least one percent of what is being protected
load 1
gtxns AssetAmount
load 0
gtxns AssetAmount
int 100
/
>=
bz reject

// and never less than the floor
load 1
gtxns AssetAmount
int FEE_MIN
>=
bz reject

allow:
int 1
return

reject:
int 0
return
